{
  "name": "dtl-reader",
  "displayName": "DTL Reader",
  "description": "Syntax highlighting, file icon and color theme for DTL (Dialogic2) files",
  "version": "0.1.0",
  "publisher": "lorentyfle",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dtl",
        "aliases": [
          "DTL"
        ],
        "extensions": [
          ".dtl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dtl.svg",
          "dark": "./icons/dtl.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dtl",
        "scopeName": "source.dtl",
        "path": "./syntaxes/dtl.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "id": "dtl-dark",
        "label": "DTL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dtl-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
