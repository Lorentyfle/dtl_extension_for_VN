{
  "name": "dtl-reader",
  "displayName": "DTL Reader",
  "description": "Syntax highlighting for Dialogic2 TimeLine (.dtl) files",
  "version": "0.1.4",
  "publisher": "lorentyfle",
  "icon": "./icons/favicon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lorentyfle/dtl_extension_for_VN"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dtl",
        "aliases": [
          "DTL"
        ],
        "extensions": [
          ".dtl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dtl.svg",
          "dark": "./icons/favicon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dtl",
        "scopeName": "source.dtl",
        "path": "./syntaxes/dtl.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "id": "dtl-dark",
        "label": "DTL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dtl-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "[dtl]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
