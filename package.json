{
  "name": "dtl-reader",
  "displayName": "DTL Reader",
  "description": "Syntax highlighting for Dialogic2 TimeLine (.dtl) files",
  "version": "1.0.9",
  "publisher": "lorentyfle",
  "icon": "./icons/favicon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lorentyfle/dtl_extension_for_VN"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dtl",
        "aliases": [
          "DTL"
        ],
        "extensions": [
          ".dtl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dtl.svg",
          "dark": "./icons/favicon.svg"
        }
      },
      {
        "id": "dch",
        "aliases": [
          "Dialogic Character"
        ],
        "extensions": [
          ".dch"
        ],
        "configuration": "./dch-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dtl",
        "scopeName": "source.dtl",
        "path": "./syntaxes/dtl.tmLanguage.json"
      },
      {
        "language": "dch",
        "scopeName": "source.dch",
        "path": "./syntaxes/dch.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "id": "dtl-dark",
        "label": "DTL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dtl-color-theme.json"
      },
      {
        "id": "dtl-light",
        "label": "DTL Light",
        "uiTheme": "vs",
        "path": "./themes/dtl-color-theme-light.json"
      },
      {
        "id": "dtl-dracula",
        "label": "DTL Dracula",
        "uiTheme": "vs-dark",
        "path": "./themes/dtl-color-theme-dracula.json"
      },
      {
        "id": "dtl-godot",
        "label": "DTL Godot-like",
        "uiTheme": "vs-dark",
        "path": "./themes/dtl-color-theme-godot.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "dtl",
        "scopes": {
          "class": ["support.class.global.dtl"],
          "property": ["variable.other.member.dtl"],
          "enum": ["entity.name.type.enum.dtl"],
          "enumMember": ["constant.other.enum-member.dtl"],
          "function": ["support.function.dtl"]
        }
      }
    ],
    "configuration": {
      "title": "DTL Reader",
      "properties": {
        "dtlReader.outline.showFlow": {
          "type": "boolean",
          "default": true,
          "description": "In the Outline view, list each label's flow (if/elif/else/while blocks, choices, jump/return/end_timeline), nested by indentation. When off, the outline only lists the labels."
        },
        "dtlReader.includeAddonAutoloads": {
          "type": "boolean",
          "default": false,
          "description": "Also suggest autoloads declared by addons (scripts or scenes under res://addons/, e.g. Dialogic's own \"Dialogic\" singleton) in do/if/elif and {...} autocomplete. Off by default, since addon autoloads usually expose hundreds of members that are not meant to be used from a timeline."
        }
      }
    },
    "configurationDefaults": {
      "[dtl]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "editor.autoIndent": "full"
      },
      "[dch]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
