{
  "name": "DTL Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "editorLineNumber.foreground": "#5a5a5a",
    "editorLineNumber.activeForeground": "#d4d4d4",
    "editorCursor.foreground": "#61afef",
    "editor.selectionBackground": "#264f78",
    "editor.selectionHighlightBackground": "#3a3d41",
    "editor.inactiveSelectionBackground": "#3a3d41",
    "editor.lineHighlightBackground": "#2a2a2a",
    "editor.findMatchBackground": "#515c6a",
    "editor.findMatchHighlightBackground": "#3a3d41",
    "editorWhitespace.foreground": "#3b3b3b",
    "editorIndentGuide.background1": "#3b3b3b",
    "editorIndentGuide.activeBackground1": "#707070",
    "editorBracketMatch.background": "#264f78",
    "editorBracketMatch.border": "#61afef",

    "editorWidget.background": "#252526",
    "editorWidget.foreground": "#d4d4d4",
    "editorWidget.border": "#454545",
    "editorHoverWidget.background": "#252526",
    "editorHoverWidget.border": "#454545",
    "editorSuggestWidget.background": "#252526",
    "editorSuggestWidget.border": "#454545",
    "editorSuggestWidget.selectedBackground": "#062f4a",
    "editorSuggestWidget.highlightForeground": "#61afef",

    "activityBar.background": "#181818",
    "activityBar.foreground": "#d4d4d4",
    "activityBar.inactiveForeground": "#6c6c6c",
    "activityBarBadge.background": "#e5c07b",
    "activityBarBadge.foreground": "#1e1e1e",

    "sideBar.background": "#1a1a1a",
    "sideBar.foreground": "#cccccc",
    "sideBarTitle.foreground": "#d4d4d4",
    "sideBarSectionHeader.background": "#1a1a1a",
    "list.activeSelectionBackground": "#2a2d2e",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#242424",
    "list.hoverBackground": "#232323",
    "list.highlightForeground": "#61afef",

    "statusBar.background": "#181818",
    "statusBar.foreground": "#cccccc",
    "statusBar.noFolderBackground": "#181818",
    "statusBar.debuggingBackground": "#c586c0",
    "statusBar.debuggingForeground": "#1e1e1e",

    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#cccccc",
    "titleBar.inactiveBackground": "#181818",
    "titleBar.inactiveForeground": "#6c6c6c",

    "tab.activeBackground": "#1e1e1e",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#181818",
    "tab.inactiveForeground": "#8a8a8a",
    "tab.border": "#1a1a1a",
    "tab.activeBorderTop": "#e5c07b",
    "editorGroupHeader.tabsBackground": "#181818",

    "panel.background": "#181818",
    "panel.border": "#2b2b2b",
    "panelTitle.activeForeground": "#d4d4d4",
    "panelTitle.activeBorder": "#e5c07b",
    "terminal.background": "#1e1e1e",
    "terminal.foreground": "#d4d4d4",

    "button.background": "#3a5f7d",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#456f92",
    "input.background": "#2a2a2a",
    "input.foreground": "#d4d4d4",
    "input.border": "#3b3b3b",
    "dropdown.background": "#2a2a2a",
    "dropdown.foreground": "#d4d4d4",

    "scrollbarSlider.background": "#4a4a4a80",
    "scrollbarSlider.hoverBackground": "#5a5a5a80",
    "scrollbarSlider.activeBackground": "#6a6a6a80",

    "badge.background": "#4fcc96",
    "badge.foreground": "#1e1e1e",
    "progressBar.background": "#61afef",

    "gitDecoration.modifiedResourceForeground": "#e2c08d",
    "gitDecoration.addedResourceForeground": "#4fcc96",
    "gitDecoration.deletedResourceForeground": "#f44747",
    "gitDecoration.untrackedResourceForeground": "#4fcc96",

    "focusBorder": "#3a5f7d",
    "widget.shadow": "#00000066"
  },
  "tokenColors": [
    {
      "comment": "-- Baseline (Dark+-like) rules for ordinary code scopes --",
      "settings": { "foreground": "#d4d4d4" }
    },
    { "scope": "comment", "settings": { "foreground": "#6a9955", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#ce9178" } },
    { "scope": "constant.numeric", "settings": { "foreground": "#b5cea8" } },
    { "scope": "constant.language", "settings": { "foreground": "#569cd6" } },
    { "scope": "keyword", "settings": { "foreground": "#c586c0" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#d4d4d4" } },
    { "scope": "support.function", "settings": { "foreground": "#dcdcaa" } },
    { "scope": "punctuation", "settings": { "foreground": "#808080" } },

    {
      "comment": "-- DTL-specific scopes: each concept gets its own color, independent of the generic rules above --",
      "scope": "entity.name.translationid.dtl",
      "settings": { "foreground": "#7a7a7a", "fontStyle": "italic" }
    },
    {
      "scope": "entity.name.character.dtl",
      "settings": { "foreground": "#e5c07b", "fontStyle": "bold" }
    },
    {
      "comment": "Spoken dialogue text is left uncolored on purpose: it inherits editor.foreground (#d4d4d4) like plain prose, instead of a distinct string color. Add a 'foreground' here if you'd rather it stood out.",
      "scope": "string.unquoted.dialogue.dtl",
      "settings": {  "foreground": "#fff3de" }
    },
    {
      "comment": "Choice wording ('- text') gets its own color so it reads as content rather than plain code text.",
      "scope": "markup.list.choice.dtl",
      "settings": { "foreground": "#4fcc96" }
    },
    {
      "comment": "Target name after 'label' / 'jump'.",
      "scope": "entity.name.label.dtl",
      "settings": { "foreground": "#e0af68", "fontStyle": "bold" }
    },
    {
      "scope": ["punctuation.definition.tag.begin.signal.dtl", "punctuation.definition.tag.end.signal.dtl"],
      "settings": { "foreground": "#f44747" }
    },
    {
      "scope": "meta.text_input.dtl",
      "settings": { "foreground": "#ff53a9" }
    },
    {
      "scope": "variable.parameter.signal.dtl",
      "settings": { "foreground": "#f28b82" }
    },
    {
      "scope": ["punctuation.definition.tag.begin.dtl", "punctuation.definition.tag.end.dtl"],
      "settings": { "foreground": "#61afef" }
    },
    {
      "scope": "entity.other.attribute-name.dtl",
      "settings": { "foreground": "#9cdcfe" }
    },
    {
      "scope": "keyword.control.choice.dtl",
      "settings": { "foreground": "#d19a66" }
    },
    {
      "scope": "punctuation.definition.list.begin.dtl",
      "settings": { "foreground": "#56b6c2", "fontStyle": "bold" }
    },
    {
      "scope": "punctuation.separator.choice.dtl",
      "settings": { "foreground": "#7b00ff" }
    },
    {
      "scope": ["punctuation.definition.variable.begin.dtl", "punctuation.definition.variable.end.dtl"],
      "settings": { "foreground": "#4ec9b0" }
    },
    {
      "scope": "meta.endtimeline.dtl",
      "settings": { "foreground": "#ff8fd2", "fontStyle": "bold"}
    },
    {
      "scope": "meta.images.dtl",
      "settings": { "foreground": "#c8c465", "fontStyle": "italic" }
    },
    {
      "scope": "meta.clear.dtl",
      "settings": { "foreground": "#949493" }
    },
    {
      "scope": "variable.language.all.dtl",
      "settings": { "foreground": "#f79cd7","fontStyle": "bold" }
    },
    {
      "scope": "variable.parameter.transform.dtl",
      "settings": { "foreground": "#31af50" }
    },
    {
      "scope": "meta.wait.dtl",
      "settings": { "foreground": "#9b83fa" }
    },
    {
      "scope": "variable.other.property.dtl",
      "settings": { "foreground": "#9cdcfe" }
    },
    {
      "scope": "punctuation.accessor.dtl",
      "settings": { "foreground": "#808080" }
    },
    {
      "scope": "support.type.audio-kind.dtl",
      "settings": { "foreground": "#56b6c2" }
    },
    {
      "comment": "-- Mood/emotion: one shared scope for join/update's '(mood)' tag, the dialogue speaker's '(mood)' tag, and extra_data=\"set Path/To/Mood\" - all three refer to the same LayeredSprite emotion concept, so they read as one color. --",
      "scope": "variable.other.emotion.dtl",
      "settings": { "foreground": "#f5a623", "fontStyle": "bold" }
    },
    {
      "scope": ["punctuation.definition.emotion.begin.dtl", "punctuation.definition.emotion.end.dtl"],
      "settings": { "foreground": "#f5a623" }
    },
    {
      "comment": "The literal 'set ' inside extra_data=\"set ...\" stays a dim, string-like color so only the emotion value itself (variable.other.emotion.dtl) pops out.",
      "scope": "keyword.control.emotion-set.dtl",
      "settings": { "foreground": "#ce9178", "fontStyle": "italic" }
    },
    {
      "comment": "-- BBCode-style balise formatting inside dialogue/narration/choice text. fontStyle is what makes the enclosed text actually render bold/italic/underline/strikethrough - the grammar only ever applies these scopes to text strictly between a matched opening and closing tag, never beyond. --",
      "scope": "markup.bold.dtl",
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": "markup.italic.dtl",
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": "markup.underline.dtl",
      "settings": { "fontStyle": "underline" }
    },
    {
      "scope": "markup.strikethrough.dtl",
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "comment": "Any custom/personalized balise whose effect isn't one of the four known ones above - given its own color since the actual visual effect is unknown to the editor.",
      "scope": "markup.custom-balise.dtl",
      "settings": { "foreground": "#c792ea" }
    },
    {
      "comment": "-- Combined balise styles. Plain nested scopes don't auto-merge fontStyle in VS Code (the innermost tag would otherwise silently win and the outer style would be lost), so each 2-tag pairing gets its own explicit rule, in both nesting orders (e.g. [b][i] and [i][b] both need to match). 3+ levels of nesting aren't covered and fall back to the innermost tag's single style. --",
      "scope": [
        "markup.bold.dtl markup.italic.dtl",
        "markup.italic.dtl markup.bold.dtl"
      ],
      "settings": { "fontStyle": "bold italic" }
    },
    {
      "scope": [
        "markup.bold.dtl markup.underline.dtl",
        "markup.underline.dtl markup.bold.dtl"
      ],
      "settings": { "fontStyle": "bold underline" }
    },
    {
      "scope": [
        "markup.bold.dtl markup.strikethrough.dtl",
        "markup.strikethrough.dtl markup.bold.dtl"
      ],
      "settings": { "fontStyle": "bold strikethrough" }
    },
    {
      "scope": [
        "markup.italic.dtl markup.underline.dtl",
        "markup.underline.dtl markup.italic.dtl"
      ],
      "settings": { "fontStyle": "italic underline" }
    },
    {
      "scope": [
        "markup.italic.dtl markup.strikethrough.dtl",
        "markup.strikethrough.dtl markup.italic.dtl"
      ],
      "settings": { "fontStyle": "italic strikethrough" }
    },
    {
      "scope": [
        "markup.underline.dtl markup.strikethrough.dtl",
        "markup.strikethrough.dtl markup.underline.dtl"
      ],
      "settings": { "fontStyle": "underline strikethrough" }
    }
  ]
}
