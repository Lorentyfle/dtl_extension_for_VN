{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((if|elif|else)\\b.*:|-\\s.*)\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*((if|elif|else|while)\\b.*:|-\\s.*)\\s*$",
      "action": { "indentAction": "indent" }
    }
  ]
}