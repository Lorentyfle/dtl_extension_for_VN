{
  "name": "DTL",
  "scopeName": "source.dtl",

  "patterns": [
    { "include": "#translationid" },
    { "include": "#comments" },
    { "include": "#signals" },
    { "include": "#wait"},
    { "include": "#audio"},
    { "include": "#clear"},
    { "include": "#images"},
    { "include": "#text_input"},
    { "include": "#end_timeline"},
    { "include": "#options" },
    { "include": "#commands" },
    { "include": "#flow" },
    { "include": "#variables" },
    { "include": "#dialogue" },
    { "include": "#narration" },
    { "include": "#choices" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operator" }
  ],

  "repository": {

    "operator": {
      "patterns": [
        { "name": "keyword.operator.dtl", "match": "(==|!=|>=|<=|>|<|\\+=|-=|=)" }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.dtl", "match": "\\b-?\\d+(?:\\.\\d+)?\\b" }
      ]
    },

    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.dtl", "match": "#(?!id:).*$" }
      ]
    },

    "translationid": {
      "patterns": [
        { "name": "entity.name.translationid.dtl", "match": "#id:[A-Za-z0-9_]+" }
      ]
    },

    "commands": {
      "patterns": [
        { "name": "keyword.control.command.dtl", "match": "\\b(join|leave|update|audio|do|return)\\b" },
        { "name": "support.type.audio-kind.dtl", "match": "(?<=\\baudio\\b)\\s+([^\\s\"]+)" },
        { "name": "constant.language.position.dtl", "match": "\\b(left|right|center|rightmost|leftmost)\\b" },
        { "name": "entity.name.character.dtl", "match": "(?<=\\b(join|update|leave)\\s)[\\p{L}_][\\p{L}0-9_]*" },
        { "name": "variable.language.all.dtl", "match": "^\\s*leave\\s+(--All--)"},
        { "name": "variable.parameter.transform.dtl", "match": "(?<=^\\s*(?:join|update)[^\\r\\n]*)\\b(pos|size|rot)\\b(?=\\s*=)"}
      ]
    },

    "flow": {
      "comment": "if / else / elif / set / label / jump / not / and / or / in all share keyword.control.flow.dtl so a theme colors them identically. label/jump additionally tag their target name with entity.name.label.dtl, mirroring how #commands tags character names after join/update/leave.",
      "patterns": [
        { "name": "keyword.control.flow.dtl", "match": "\\b(if|else|elif|set|label|jump|while|not|or|and|in)\\b" },
        { "name": "entity.name.label.dtl", "match": "(?<=\\b(label|jump)\\s)[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "punctuation.section.block.dtl", "match": ":\\s*$" }
      ]
    },

    "variables": {
      "comment": "{path.to.value} — braces and dot-separated segments get their own scopes so a theme can shade the path differently from plain text.",
      "patterns": [
        {
          "name": "variable.other.dtl",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.definition.variable.begin.dtl" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.definition.variable.end.dtl" } },
          "patterns": [
            { "name": "punctuation.accessor.dtl", "match": "\\." },
            { "name": "variable.other.property.dtl", "match": "[A-Za-z_][A-Za-z0-9_]*" }
          ]
        }
      ]
    },

    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.dtl", "match": "\\b(true|false)\\b" },
        { "name": "support.function.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()" }
      ]
    },

    "balises": {
      "comment": "BBCode-style rich text tags used inside player-facing text: [b]bold[/b], [i]italic[/i], [u]underline[/u], [s]strikethrough[/s], and any other custom effect tag like [MyEffect]text[/MyEffect]. Each opening tag only matches if a lookahead confirms its matching closer exists later on the SAME line - if no closer is found, nothing highlights here at all (the brackets stay plain text), so the tag's highlighting is always strictly the region between the two tags and never spills onto the rest of the line. An unclosed tag is instead caught by the whole-line diagnostic in extension.js. Each rule includes #balises itself so tags can nest/combine, e.g. [b][i]bold italic[/i][/b] - the theme has matching combined-scope rules for every 2-tag pairing so both effects actually render together; 3+ levels of nesting will fall back to showing just the innermost tag's style.",
      "patterns": [
        {
          "name": "markup.bold.dtl",
          "begin": "\\[b\\](?=[^\\n]*\\[/b\\])",
          "end": "\\[/b\\]",
          "patterns": [ { "include": "#balises" }, { "include": "#variables" } ]
        },
        {
          "name": "markup.italic.dtl",
          "begin": "\\[i\\](?=[^\\n]*\\[/i\\])",
          "end": "\\[/i\\]",
          "patterns": [ { "include": "#balises" }, { "include": "#variables" } ]
        },
        {
          "name": "markup.underline.dtl",
          "begin": "\\[u\\](?=[^\\n]*\\[/u\\])",
          "end": "\\[/u\\]",
          "patterns": [ { "include": "#balises" }, { "include": "#variables" } ]
        },
        {
          "name": "markup.strikethrough.dtl",
          "begin": "\\[s\\](?=[^\\n]*\\[/s\\])",
          "end": "\\[/s\\]",
          "patterns": [ { "include": "#balises" }, { "include": "#variables" } ]
        },
        {
          "name": "markup.custom-balise.dtl",
          "comment": "Any other personalized balise, e.g. [Shake]text[/Shake]. Reserved bracket commands (wait, audio, signal...) are excluded via the lookahead so they keep using #options as before.",
          "begin": "\\[(?!(?:wait|wait_input|audio|voice|clear|background|style|signal|text_input|end_timeline)\\])([A-Za-z_][A-Za-z0-9_]*)\\](?=[^\\n]*\\[/\\1\\])",
          "end": "\\[/\\1\\]",
          "patterns": [ { "include": "#balises" }, { "include": "#variables" } ]
        }
      ]
    },

    "dialogue": {
      "comment": "Speaker line 'Name: text [inline=options] #id:xyz'. The spoken text is a begin/end region so inline markup like [pause=1.5], [b]bold[\\b], and {variable} references still highlight.",
      "patterns": [
        { "name": "entity.name.character.dtl", "match": "^\\s*(?!(?:if|else|elif|set|label|while|jump)\\s*:)[\\p{L}_][\\p{L}0-9_]*(?=\\s*:)" },
        {
          "name": "string.unquoted.dialogue.dtl",
          "begin": "(?<=:)\\s",
          "end": "(?=#id:|$)",
          "patterns": [
            { "include": "#balises" },
            { "include": "#signals" },
            { "include": "#wait" },
            { "include": "#audio" },
            { "include": "#clear" },
            { "include": "#images" },
            { "include": "#text_input" },
            { "include": "#end_timeline" },
            { "include": "#options" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "narration": {
      "comment": "A line with no 'Character:' prefix is still spoken/narrated text in Dialogic - a nameless speaker gets the same treatment as a named one. Reuses #dialogue's text scope and nested patterns. The negative lookaheads exclude anything that is actually a comment, choice, bracket command, or flow/command keyword line, so those keep their own dedicated highlighting instead of being swallowed as narration.",
      "patterns": [
        {
          "name": "string.unquoted.dialogue.dtl",
          "begin": "^(?!\\s*$)(?!\\s*#)(?!\\s*-\\s)(?!\\s*\\[)(?!\\s*(if|else|elif|set|label|jump|while|join|leave|update|audio|do|return)\\b)(?!\\s*[\\p{L}_][\\p{L}0-9_]*\\s*:)",
          "end": "(?=#id:|$)",
          "patterns": [
            { "include": "#balises" },
            { "include": "#signals" },
            { "include": "#wait" },
            { "include": "#audio" },
            { "include": "#clear" },
            { "include": "#images" },
            { "include": "#text_input" },
            { "include": "#end_timeline" },
            { "include": "#options" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "choices": {
      "comment": "'- choice text | [if ...] [else=...] #id:xyz'. The leading dash is punctuation. Only the choice wording gets the choice color and stops before |, #, or the end of the line.",
      "patterns": [
        {
          "begin": "^(\\s*)(-)(\\s)",
          "beginCaptures": {
            "2": { "name": "punctuation.definition.list.begin.dtl" }
          },
          "end": "(?=\\||#|\\r?$)",
          "patterns": [
            { "name": "markup.list.choice.dtl", "match": "\\S(?:[^|#\\[\\]\\r\\n]|\\[(?![^\\]\\r\\n]*\\])[^|#\\r\\n])*?(?=\\||#|\\[|\\r?$)"},
            { "name": "punctuation.separator.choice.dtl", "match": "\\|"},
            { "include": "#translationid" },
            { "include": "#balises" },
            { "include": "#signals" },
            { "include": "#wait" },
            { "include": "#audio" },
            { "include": "#clear" },
            { "include": "#images" },
            { "include": "#text_input" },
            { "include": "#end_timeline" },
            { "include": "#options" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "signals": {
      "comment": "[signal arg_type=\"dict\" arg=\"{...}\"] - kept as its own repository (rather than folded into #options) so it can be themed as a distinct 'event' scope.",
      "patterns": [
        {
          "name": "meta.signal.dtl",
          "begin": "\\[signal\\b",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.begin.signal.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.signal.dtl" } },
          "patterns": [
            { "name": "variable.parameter.signal.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" }
          ]
        }
      ]
    },

    "end_timeline" : {
      "patterns": [
        {
          "name" : "meta.endtimeline.dtl",
          "match": "\\[end_timeline\\]"
        }
      ]
    },

    "wait": {
      "comment": "[wait or wait_input] flag type.",
      "patterns": [
        {
          "name": "meta.options.dtl",
          "begin": "\\[\\b(wait|wait_input)\\b\\b",
          "beginCaptures": { "0": { "name": "meta.wait.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.dtl" } },
          "patterns": [
            { "name": "keyword.control.choice.dtl", "match": "\\b(if|elif|else)\\b" },
            { "name": "entity.other.attribute-name.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "text_input": {
      "comment": "[text_input] flag type.",
      "patterns": [
        {
          "name": "meta.text_input.dtl",
          "begin": "\\[text_input\\b",
          "beginCaptures": { "0": { "name": "meta.text_input.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.dtl" } },
          "patterns": [
            { "name": "keyword.control.choice.dtl", "match": "\\b(if|elif|else)\\b" },
            { "name": "entity.other.attribute-name.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "audio": {
      "comment": "[voice or audio] flag type.",
      "patterns": [
        {
          "name": "meta.options.dtl",
          "begin": "\\[\\b(audio|voice)\\b\\b",
          "beginCaptures": { "0": { "name": "support.type.audio-kind.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.dtl" } },
          "patterns": [
            { "name": "keyword.control.choice.dtl", "match": "\\b(if|elif|else)\\b" },
            { "name": "entity.other.attribute-name.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "clear": {
      "comment": "[clear ] flag type.",
      "patterns": [
        {
          "name": "meta.options.dtl",
          "begin": "\\[clear\\b",
          "beginCaptures": { "0": { "name": "meta.clear.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.dtl" } },
          "patterns": [
            { "name": "keyword.control.choice.dtl", "match": "\\b(if|elif|else)\\b" },
            { "name": "entity.other.attribute-name.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "images": {
      "comment": "[background or style ] flag type.",
      "patterns": [
        {
          "name": "meta.images.dtl",
          "begin": "\\[\\b(background|style)\\b\\b",
          "beginCaptures": { "0": { "name": "meta.images.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.dtl" } },
          "patterns": [
            { "name": "keyword.control.choice.dtl", "match": "\\b(if|elif|else)\\b" },
            { "name": "entity.other.attribute-name.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "options": {
      "comment": "Generic '[key=value key2=\"value2\"]' bracket block used by commands, choices and inline dialogue markup (extra_data, animation, pause, if/else, alt_text...).",
      "patterns": [
        {
          "name": "meta.options.dtl",
          "begin": "\\[",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.begin.dtl" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.dtl" } },
          "patterns": [
            { "name": "keyword.control.choice.dtl", "match": "\\b(if|elif|else)\\b" },
            { "name": "entity.other.attribute-name.dtl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*=)" },
            { "include": "#operator" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#variables" }
          ]
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dtl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.dtl", "match": "\\\\." }
          ]
        }
      ]
    }
  }
}
