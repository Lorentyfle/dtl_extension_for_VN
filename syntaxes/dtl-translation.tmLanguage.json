{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DTL Translation",
  "scopeName": "source.dtl-translation",
  "comment": "The Translation View (DTL: Open Translation View): '# ...' comments, one '[key]  line N - who' header per translatable line, then 'locale: text' lines. The text reuses the timeline grammar's BBCode and {variable} rules, so it's colored like dialogue in a timeline.",
  "patterns": [
    { "name": "comment.line.number-sign.dtl", "match": "^#.*$" },
    {
      "match": "^(\\[)([^\\]]+)(\\])(.*)$",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.dtl" },
        "2": { "name": "entity.name.label.dtl" },
        "3": { "name": "punctuation.definition.tag.end.dtl" },
        "4": { "name": "comment.line.translation-context.dtl" }
      }
    },
    {
      "name": "string.unquoted.dialogue.dtl",
      "begin": "^([A-Za-z]{2,3}(?:[_-][A-Za-z0-9]+)*)(:)",
      "beginCaptures": {
        "1": { "name": "entity.name.character.dtl" },
        "2": { "name": "punctuation.separator.dtl" }
      },
      "end": "$",
      "patterns": [
        { "include": "source.dtl#balises" },
        { "include": "source.dtl#variables" }
      ]
    }
  ]
}
