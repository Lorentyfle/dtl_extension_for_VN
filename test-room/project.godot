; Minimal fake Godot project, only used so DTL Reader can find the
; Dialogic settings section it reads character names, audio channels,
; and resource paths from. This project is never meant to run in Godot.

config_version=5

[application]

config/name="DTL Reader Test Room"

[dialogic]

translation/enabled=true
glossary/glossary_files=["res://glossaries/world_glossary.tres"]
glossary/default_case_sensitive=true
translation/original_locale="en"
translation/file_mode=0
translation/translation_folder="res://translations"
directories/dch_directory={
"TestCharacter": "res://characters/TestCharacter.dch",
"TestCharacter2": "res://characters/TestCharacter2.dch",
"Test Character3": "res://characters/Test Character3.dch",
"John Smith": "res://characters/JohnSmith.dch"
}
directories/dtl_directory={
"test_timeline": "res://timelines/test_timeline.dtl",
"chapter2": "res://timelines/chapter2.dtl"
}
audio/channel_defaults={
"music":{
"audio_bus":"Master",
"fade_length":0.5,
"loop":true,
"volume":0.0
},
"sound":{
"audio_bus":"Master",
"fade_length":0.0,
"loop":false,
"volume":0.0
}
}
variables={
"variable" : {
"test": 1,
"Ttttt": true,
"Floating": 1.0,
},
"Mamamya": ":OO",
"chapter": 1,
"answer": "",
}

[autoload]

Global="*res://scripts/Global.gd"
SoundManager="*res://scripts/SoundManager.tscn"
